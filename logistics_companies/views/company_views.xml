<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_logistics_companies" model="ir.actions.act_window">
        <field name="name">Compañías</field>
        <field name="res_model">res.partner</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="domain">['|', ('category_id.name', 'ilike', 'Operador Log'), ('category_id.name', 'ilike', 'Logist')]</field>
        <field name="context">{'default_is_company': True}</field>
        <field name="search_view_id" ref="base.view_res_partner_filter"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Crea una nueva compañía logística
            </p>
        </field>
    </record>

    <menuitem id="menu_logistics_companies_root"
              name="Compañías"
              action="action_logistics_companies"
              web_icon="contacts,static/description/icon.png"
              sequence="25"/>

    <menuitem id="menu_logistics_companies_sub"
              name="Compañías"
              parent="menu_logistics_companies_root"
              action="action_logistics_companies"
              sequence="1"/>
</odoo>
